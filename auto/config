#!/bin/sh
set -eu
lb config noauto \
  --mode debian \
  --distribution bookworm \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi grub-pc" \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends false \
  --apt-options "--yes -oAcquire::Retries=3" \
  --iso-application "SMTH OS Live" \
  --iso-publisher "SMTH Project" \
  --iso-volume "SMTH_OS" \
  --bootappend-live "boot=live components quiet splash loglevel=3 systemd.show_status=false rd.udev.log_level=3 vt.global_cursor_default=0 logo.nologo username=smth hostname=smth-os" \
  "${@}"
