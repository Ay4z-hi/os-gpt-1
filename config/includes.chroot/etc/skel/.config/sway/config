set $mod Mod4
font pango:Inter 10
floating_modifier $mod normal
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 8
# SMTH monochrome shell; the two accent colours are coral and teal.
client.focused #FF315A #000000 #FFFFFF #20D9C2 #FF315A
client.unfocused #FFFFFF #000000 #FFFFFF #FFFFFF #FFFFFF
client.urgent #FF315A #000000 #FFFFFF #FF315A #FF315A
exec waybar
exec mako
exec nm-applet
exec blueman-applet
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec swayidle -w timeout 300 'swaylock -c 000000' timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'
exec smth-wallpaper
# Keyboard shortcuts
bindsym $mod+Return exec foot
bindsym $mod+d exec wofi --show drun
bindsym $mod+e exec thunar
bindsym $mod+b exec firefox-esr --new-window
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+l exec swaylock -c 000000
bindsym $mod+Shift+e exec smth-session-exit
bindsym $mod+comma exec smth-settings
# Touchpad defaults; compositor adapts when a touchscreen is detected.
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
