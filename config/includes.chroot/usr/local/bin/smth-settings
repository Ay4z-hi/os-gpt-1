#!/bin/sh
set -eu
wifi_state=$(nmcli -t -f WIFI radio 2>/dev/null | head -n1 || true)
[ "$wifi_state" = enabled ] && wifi_label="WI-FI  /  ON" || wifi_label="WI-FI  /  OFF"
bt_state=$(bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo on || echo off)
[ "$bt_state" = on ] && bt_label="BLUETOOTH  /  ON" || bt_label="BLUETOOTH  /  OFF"
mute_state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
case "$mute_state" in *MUTED*) audio_label="AUDIO  /  MUTED";; *) audio_label="AUDIO  /  ACTIVE";; esac
choice=$(printf '%s\n' "DISPLAY & MONITORS" "$wifi_label" "$bt_label" "$audio_label" "WALLPAPER / APPEARANCE" "AHIAN / ALTERNATE DESKTOP" "APP STORE" "SESSION / POWER" | wofi --dmenu --prompt 'SMTH / CONTROL' --width 560 --height 420)
case "$choice" in
  "DISPLAY & MONITORS") exec wdisplays ;;
  "WI-FI  /  ON") nmcli radio wifi off && notify-send "SMTH / NETWORK" "Wi-Fi disabled" ;;
  "WI-FI  /  OFF") nmcli radio wifi on && notify-send "SMTH / NETWORK" "Wi-Fi enabled" ;;
  "BLUETOOTH  /  ON") bluetoothctl power off && notify-send "SMTH / BLUETOOTH" "Bluetooth disabled" ;;
  "BLUETOOTH  /  OFF") bluetoothctl power on && notify-send "SMTH / BLUETOOTH" "Bluetooth enabled" ;;
  "AUDIO  /  MUTED") wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 ;;
  "AUDIO  /  ACTIVE") wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 ;;
  "WALLPAPER / APPEARANCE") exec smth-wallpaper --choose ;;
  "AHIAN / ALTERNATE DESKTOP") exec ahian ;;
  "APP STORE") exec smth-store ;;
  "SESSION / POWER") exec smth-session-exit ;;
  *) exit 0 ;;
esac
