#!/bin/sh
set -eu
choice=$(printf 'DISPLAY & APPEARANCE\nWI-FI / NETWORK\nBLUETOOTH\nSOUND & AUDIO\nSESSION / POWER' | wofi --dmenu --prompt 'SMTH / CONTROL' --width 520 --height 340)
case "$choice" in
  "DISPLAY & APPEARANCE") exec wdisplays ;;
  "WI-FI / NETWORK") exec nm-connection-editor ;;
  Bluetooth|BLUETOOTH) exec blueman-manager ;;
  "SOUND & AUDIO") exec pavucontrol ;;
  "SESSION / POWER") exec smth-session-exit ;;
  *) exit 0 ;;
esac
