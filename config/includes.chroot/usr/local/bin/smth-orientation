#!/usr/bin/python3
"""Rotate portrait-oriented outputs into a landscape desktop session."""
import json, subprocess, sys
def sway(*args):
    subprocess.run(["swaymsg", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
def orient():
    try:
        outputs=json.loads(subprocess.check_output(["swaymsg","-t","get_outputs","-r"],text=True,timeout=3))
    except Exception:
        return
    for output in outputs:
        mode=output.get("current_mode") or {}
        width,height=mode.get("width",0),mode.get("height",0)
        if not width or not height: continue
        transform=str(output.get("transform","normal")).lower()
        if height>width and transform not in ("90","270","90cw","90ccw"):
            sway("output",output["name"],"transform","90")
        elif width>=height and transform not in ("normal","0"):
            sway("output",output["name"],"transform","normal")
orient()
try:
    proc=subprocess.Popen(["swaymsg","-t","subscribe","-m","-r",'["output"]'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True,bufsize=1)
    for _line in proc.stdout: orient()
except Exception:
    sys.exit(0)
