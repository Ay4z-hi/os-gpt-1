#!/bin/sh
set -eu
MODE="${1:-toggle}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/smth"
STATE="$CONFIG/ahian.enabled"
WALL_NORMAL=/usr/share/backgrounds/smth/smth-eclipse.svg
WALL_AHIAN=/usr/share/backgrounds/smth/smth-ahian.svg
mkdir -p "$CONFIG"
enable_mode() {
  : > "$STATE"
  swaymsg "output * bg $WALL_AHIAN fill" >/dev/null 2>&1 || true
  swaymsg "gaps inner 14" >/dev/null 2>&1 || true
  swaymsg "gaps outer 14" >/dev/null 2>&1 || true
  swaymsg "default_border pixel 3" >/dev/null 2>&1 || true
  pkill -USR2 waybar 2>/dev/null || true
  notify-send "SMTH / AHIAN" "Visual mode activated" 2>/dev/null || true
}
disable_mode() {
  rm -f "$STATE"
  swaymsg "output * bg $WALL_NORMAL fill" >/dev/null 2>&1 || true
  swaymsg "gaps inner 8" >/dev/null 2>&1 || true
  swaymsg "gaps outer 8" >/dev/null 2>&1 || true
  swaymsg "default_border pixel 2" >/dev/null 2>&1 || true
  pkill -USR2 waybar 2>/dev/null || true
  notify-send "SMTH" "AHIAN mode deactivated" 2>/dev/null || true
}
case "$MODE" in
  on) enable_mode ;;
  off|--off) disable_mode ;;
  toggle)
    if [ -e "$STATE" ]; then disable_mode; else enable_mode; fi
    ;;
  *) echo "Usage: ahian [on|off|--off]"; exit 2 ;;
esac
