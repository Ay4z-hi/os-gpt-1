#!/bin/sh
set -eu
MODE="${1:-toggle}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
SMTH_CONFIG="$CONFIG/smth"
STATE="$SMTH_CONFIG/ahian.enabled"
WALL_NORMAL=/usr/share/backgrounds/smth/smth-eclipse.svg
WALL_AHIAN=/usr/share/backgrounds/smth/smth-ahian.svg
mkdir -p "$SMTH_CONFIG" "$CONFIG/waybar" "$CONFIG/wofi"

enable_mode() {
  : > "$STATE"
  if [ -f /usr/share/smth/ahian-wofi.css ]; then
    cp /usr/share/smth/ahian-wofi.css "$CONFIG/wofi/style.css"
  fi
  swaymsg "output * bg $WALL_AHIAN fill" >/dev/null 2>&1 || true
  swaymsg "gaps inner 16" >/dev/null 2>&1 || true
  swaymsg "gaps outer 12" >/dev/null 2>&1 || true
  swaymsg "default_border pixel 2" >/dev/null 2>&1 || true
  swaymsg "client.focused #D71921 #080808 #F2F2F2 #777777 #D71921" >/dev/null 2>&1 || true
  pkill -USR2 waybar 2>/dev/null || true
  notify-send "SMTH / AHIAN" "A different, calmer desktop is ready." 2>/dev/null || true
}

disable_mode() {
  rm -f "$STATE"
  if [ -f /etc/skel/.config/wofi/style.css ]; then
    cp /etc/skel/.config/wofi/style.css "$CONFIG/wofi/style.css"
  fi
  swaymsg "output * bg $WALL_NORMAL fill" >/dev/null 2>&1 || true
  swaymsg "gaps inner 10" >/dev/null 2>&1 || true
  swaymsg "gaps outer 8" >/dev/null 2>&1 || true
  swaymsg "default_border pixel 1" >/dev/null 2>&1 || true
  swaymsg "client.focused #D71921 #080808 #F2F2F2 #777777 #D71921" >/dev/null 2>&1 || true
  pkill -USR2 waybar 2>/dev/null || true
  notify-send "SMTH" "Standard desktop restored." 2>/dev/null || true
}

case "$MODE" in
  on) enable_mode ;;
  off|--off|unahian) disable_mode ;;
  toggle) if [ -e "$STATE" ]; then disable_mode; else enable_mode; fi ;;
  *) echo "Usage: ahian [on|off|--off] (unahian restores normal mode)" >&2; exit 2 ;;
esac
