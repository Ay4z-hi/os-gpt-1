#!/bin/sh
set -eu
# Enable core services in the installed/live system.
systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable systemd-timesyncd.service
# Create a non-root default account for live sessions.
if ! id smth >/dev/null 2>&1; then
  useradd -m -s /usr/bin/zsh -G sudo,audio,video,plugdev smth
fi
printf '%s\n' 'smth ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/90-smth-live
chmod 0440 /etc/sudoers.d/90-smth-live
