#!/bin/sh
set -eu

# Enable available live-session services without aborting the image build
# when a package does not ship an enableable unit in this Debian release.
for unit in NetworkManager.service bluetooth.service greetd.service zramswap.service; do
  systemctl enable "$unit" >/dev/null 2>&1 || true
done

if ! id smth >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo,audio,video,plugdev smth
fi

printf '%s\n' 'smth ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/90-smth-live
chmod 0440 /etc/sudoers.d/90-smth-live
