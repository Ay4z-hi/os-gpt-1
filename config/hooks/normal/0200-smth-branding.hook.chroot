#!/bin/sh
set -eu
# Files are installed by config/includes.chroot. Select the custom theme.
chmod 0755 /usr/local/bin/smth-wallpaper /usr/local/bin/smth-session-exit /usr/local/bin/smth-install /usr/local/bin/smth-settings /usr/local/bin/smth-app-installer /usr/local/bin/ahian 2>/dev/null || true
if [ -d /etc/skel/Desktop ]; then
  chmod 0755 /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme smth || true
fi
