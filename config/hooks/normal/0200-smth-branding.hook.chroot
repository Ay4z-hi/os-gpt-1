#!/bin/sh
set -eu
# Files are installed by config/includes.chroot. Select the custom theme.
chmod 0755 /usr/local/bin/smth-wallpaper /usr/local/bin/smth-session-exit /usr/local/bin/ahian 2>/dev/null || true
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme smth || true
fi
