#!/bin/sh
set -eu
install -d /usr/share/pixmaps /usr/share/backgrounds/smth /usr/share/plymouth/themes/smth
install -m 0644 /config/assets/branding/smth-mark.svg /usr/share/pixmaps/smth-mark.svg 2>/dev/null || true
install -m 0644 /config/assets/wallpapers/smth-eclipse.svg /usr/share/backgrounds/smth/smth-eclipse.svg 2>/dev/null || true
install -m 0644 /config/config/plymouth/smth.plymouth /usr/share/plymouth/themes/smth/smth.plymouth 2>/dev/null || true
install -m 0644 /config/config/plymouth/smth.script /usr/share/plymouth/themes/smth/smth.script 2>/dev/null || true
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme smth || true
fi
